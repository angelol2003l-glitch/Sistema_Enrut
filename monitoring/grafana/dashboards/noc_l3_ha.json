    {
      "id": 13,
      "title": "L3 Network Topology",
      "type": "text",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;font-family:'Inter',system-ui,sans-serif;background:transparent;padding:8px;box-sizing:border-box;\">\n  <div style=\"display:flex;justify-content:center;gap:60px;align-items:flex-start;width:100%;\">\n    <div style=\"text-align:center;\">\n      <div style=\"background:#1e293b;border:2px solid #3b82f6;border-radius:8px;padding:10px 20px;min-width:100px;\">\n        <div style=\"font-size:16px;font-weight:800;color:#60a5fa;\">R1</div>\n        <div style=\"font-size:10px;color:#94a3b8;margin-top:2px;\">Core Primary</div>\n      </div>\n      <div style=\"margin-top:4px;\"><span style=\"display:inline-block;padding:2px 8px;background:rgba(34,197,94,0.15);color:#4ade80;border-radius:4px;font-size:9px;font-weight:700;letter-spacing:0.5px;\">PRIMARY — metric 1</span></div>\n    </div>\n    <div style=\"text-align:center;\">\n      <div style=\"background:#1e293b;border:2px solid #a855f7;border-radius:8px;padding:10px 20px;min-width:100px;\">\n        <div style=\"font-size:16px;font-weight:800;color:#c084fc;\">R2</div>\n        <div style=\"font-size:10px;color:#94a3b8;margin-top:2px;\">Core Backup</div>\n      </div>\n      <div style=\"margin-top:4px;\"><span style=\"display:inline-block;padding:2px 8px;background:rgba(234,179,8,0.15);color:#facc15;border-radius:4px;font-size:9px;font-weight:700;letter-spacing:0.5px;\">FLOATING — metric 10</span></div>\n    </div>\n  </div>\n  <div style=\"display:flex;justify-content:center;width:100%;margin-top:6px;\">\n    <div style=\"display:flex;align-items:center;gap:0;\">\n      <div style=\"width:80px;height:0;border-top:2px dashed #60a5fa;\"></div>\n      <div style=\"width:16px;height:16px;border-radius:50%;background:#0f172a;border:1px solid #475569;display:flex;align-items:center;justify-content:center;font-size:8px;color:#94a3b8;\">⬇</div>\n      <div style=\"width:80px;height:0;border-top:2px dashed #c084fc;\"></div>\n    </div>\n  </div>\n  <div style=\"text-align:center;margin-top:6px;\">\n    <div style=\"background:#1e293b;border:2px solid #10b981;border-radius:8px;padding:8px 24px;display:inline-block;\">\n      <div style=\"font-size:14px;font-weight:800;color:#34d399;\">R-ACCESO</div>\n      <div style=\"font-size:10px;color:#94a3b8;margin-top:2px;\">Gateway — 192.168.20.1/24</div>\n    </div>\n  </div>\n  <div style=\"border-left:2px solid #334155;height:12px;margin-top:4px;\"></div>\n  <div style=\"background:#0f172a;border:1px solid #475569;border-radius:6px;padding:6px 16px;text-align:center;\">\n    <div style=\"font-size:12px;font-weight:700;color:#e2e8f0;\">PC1</div>\n    <div style=\"font-size:9px;color:#64748b;\">Client — 192.168.20.50</div>\n  </div>\n</div>"
      }
    },
    {
      "id": 14,
