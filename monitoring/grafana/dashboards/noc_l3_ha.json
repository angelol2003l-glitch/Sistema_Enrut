    {
      "id": 15,
      "title": "L3 Path Switching",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "network_primary_path_active",
          "legendFormat": "Primary (R1)",
          "refId": "A"
        },
        {
          "expr": "network_backup_path_active",
          "legendFormat": "Backup (R2)",
          "refId": "B"
        },
        {
          "expr": "max(network_interface_down_state) or vector(0)",
          "legendFormat": "Interface DOWN",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisLabel": "",
            "axisBorderShow": false
          },
          "min": -0.1,
          "max": 1.2,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF"
                },
                "1": {
                  "text": "ON"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Primary (R1)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#22c55e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Backup (R2)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f59e0b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Interface DOWN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ef4444"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
