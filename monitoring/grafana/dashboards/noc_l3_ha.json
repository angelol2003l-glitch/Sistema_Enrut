        {
          "expr": "network_backup_path_active",
          "legendFormat": "BACKUP → R2",
          "refId": "B"
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
