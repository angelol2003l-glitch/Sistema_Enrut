      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STANDBY",
                  "color": "#334155"
                },
                "1": {
                  "text": "ACTIVE",
                  "color": "dark-green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
