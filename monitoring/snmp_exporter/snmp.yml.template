# SNMP Exporter configuration for the lab
auths:
  lab_snmp:
    community: {{SNMP_COMMUNITY}}
    version: 2

modules:
  router_ha:
    walk:
      - 1.3.6.1.2.1.1.1  # sysDescr
      - 1.3.6.1.2.1.1.3  # sysUpTime
      - 1.3.6.1.2.1.1.4  # sysContact
      - 1.3.6.1.2.1.1.5  # sysName
      - 1.3.6.1.2.1.1.6  # sysLocation
      - 1.3.6.1.2.1.2.1  # ifNumber
      - 1.3.6.1.2.1.2.2.1.1  # ifIndex
      - 1.3.6.1.2.1.2.2.1.2  # ifDescr
      - 1.3.6.1.2.1.2.2.1.3  # ifType
      - 1.3.6.1.2.1.2.2.1.4  # ifMtu
      - 1.3.6.1.2.1.2.2.1.5  # ifSpeed
      - 1.3.6.1.2.1.2.2.1.7  # ifAdminStatus
      - 1.3.6.1.2.1.2.2.1.8  # ifOperStatus
      - 1.3.6.1.2.1.2.2.1.9  # ifLastChange
      - 1.3.6.1.2.1.2.2.1.10 # ifInOctets
      - 1.3.6.1.2.1.2.2.1.11 # ifInUcastPkts
      - 1.3.6.1.2.1.2.2.1.14 # ifInErrors
      - 1.3.6.1.2.1.2.2.1.16 # ifOutOctets
      - 1.3.6.1.2.1.2.2.1.17 # ifOutUcastPkts
      - 1.3.6.1.2.1.2.2.1.20 # ifOutErrors
      - 1.3.6.1.2.1.31.1.1.1.1  # ifName
      - 1.3.6.1.2.1.31.1.1.1.6  # ifHCInOctets
      - 1.3.6.1.2.1.31.1.1.1.10 # ifHCOutOctets
      - 1.3.6.1.2.1.4.1   # ipForwarding
      - 1.3.6.1.2.1.4.3   # ipInReceives
      - 1.3.6.1.2.1.4.9   # ipInDelivers
      - 1.3.6.1.2.1.4.10  # ipOutRequests
    metrics:
      - name: sysDescr
        oid: 1.3.6.1.2.1.1.1
        type: DisplayString
        help: Textual description of the entity - 1.3.6.1.2.1.1.1
      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3
        type: gauge
        help: Time since the network management portion of the system was re-initialized - 1.3.6.1.2.1.1.3
      - name: sysContact
        oid: 1.3.6.1.2.1.1.4
        type: DisplayString
        help: Contact person for this managed node - 1.3.6.1.2.1.1.4
      - name: sysName
        oid: 1.3.6.1.2.1.1.5
        type: DisplayString
        help: Administratively-assigned name for this managed node - 1.3.6.1.2.1.1.5
      - name: sysLocation
        oid: 1.3.6.1.2.1.1.6
        type: DisplayString
        help: Physical location of this node - 1.3.6.1.2.1.1.6
      - name: ifNumber
        oid: 1.3.6.1.2.1.2.1
        type: gauge
        help: Number of network interfaces present on this system - 1.3.6.1.2.1.2.1
      - name: ifIndex
        oid: 1.3.6.1.2.1.2.2.1.1
        type: gauge
        help: Unique value for each interface - 1.3.6.1.2.1.2.2.1.1
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ifAdminStatus
        oid: 1.3.6.1.2.1.2.2.1.7
        type: gauge
        help: Desired state of the interface (1=up, 2=down, 3=testing) - 1.3.6.1.2.1.2.2.1.7
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
        enum_values:
          1: up
          2: down
          3: testing
      - name: ifOperStatus
        oid: 1.3.6.1.2.1.2.2.1.8
        type: gauge
        help: Current operational state of the interface (1=up, 2=down) - 1.3.6.1.2.1.2.2.1.8
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
        enum_values:
          1: up
          2: down
          3: testing
          4: unknown
          5: dormant
          6: notPresent
          7: lowerLayerDown
      - name: ifInOctets
        oid: 1.3.6.1.2.1.2.2.1.10
        type: counter
        help: Total number of octets received on the interface - 1.3.6.1.2.1.2.2.1.10
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ifInErrors
        oid: 1.3.6.1.2.1.2.2.1.14
        type: counter
        help: Number of inbound packets that contained errors - 1.3.6.1.2.1.2.2.1.14
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ifOutOctets
        oid: 1.3.6.1.2.1.2.2.1.16
        type: counter
        help: Total number of octets transmitted out of the interface - 1.3.6.1.2.1.2.2.1.16
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ifOutErrors
        oid: 1.3.6.1.2.1.2.2.1.20
        type: counter
        help: Number of outbound packets that could not be transmitted due to errors - 1.3.6.1.2.1.2.2.1.20
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ifHCInOctets
        oid: 1.3.6.1.2.1.31.1.1.1.6
        type: counter
        help: 64-bit total number of octets received on the interface - 1.3.6.1.2.1.31.1.1.1.6
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ifHCOutOctets
        oid: 1.3.6.1.2.1.31.1.1.1.10
        type: counter
        help: 64-bit total number of octets transmitted out of the interface - 1.3.6.1.2.1.31.1.1.1.10
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
          - labels:
              - ifIndex
            labelname: ifName
            oid: 1.3.6.1.2.1.31.1.1.1.1
            type: DisplayString
      - name: ipForwarding
        oid: 1.3.6.1.2.1.4.1
        type: gauge
        help: Indication of whether this entity is acting as an IP router (1=forwarding) - 1.3.6.1.2.1.4.1
        enum_values:
          1: forwarding
          2: notForwarding
      - name: ipInReceives
        oid: 1.3.6.1.2.1.4.3
        type: counter
        help: Total number of input datagrams received from interfaces - 1.3.6.1.2.1.4.3
      - name: ipInDelivers
        oid: 1.3.6.1.2.1.4.9
        type: counter
        help: Total number of input datagrams successfully delivered - 1.3.6.1.2.1.4.9
      - name: ipOutRequests
        oid: 1.3.6.1.2.1.4.10
        type: counter
        help: Total number of IP datagrams supplied to IP for transmission - 1.3.6.1.2.1.4.10
